---
---

<div class="search-wrapper">
  <button id="search-trigger" aria-label="Search" title="Search (Ctrl+K or /)">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
  </button>

  <div id="search-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
      <div class="search-input-wrapper">
        <input type="text" id="search-input" placeholder="搜索文章..." autocomplete="off" />
        <span class="search-hint">ESC 退出</span>
      </div>
      <div id="search-results" class="results-container"></div>
    </div>
  </div>
</div>

<script is:inline>
  let pagefind;

  async function initPagefind() {
    if (pagefind) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.options({
        "excerptLength": 20
      });
      return pagefind;
    } catch (e) {
      console.error('Failed to load pagefind:', e);
      return null;
    }
  }

  const trigger = document.getElementById('search-trigger');
  const modal = document.getElementById('search-modal');
  const backdrop = modal?.querySelector('.modal-backdrop');
  const input = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');

  function openModal() {
    modal?.classList.add('active');
    document.body.classList.add('search-open');
    setTimeout(() => input?.focus(), 50);
    initPagefind();
  }

  function closeModal() {
    modal?.classList.remove('active');
    document.body.classList.remove('search-open');
    if (input) input.value = '';
    if (resultsContainer) resultsContainer.innerHTML = '';
  }

  trigger?.addEventListener('click', openModal);
  backdrop?.addEventListener('click', closeModal);

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      openModal();
    }
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      e.preventDefault();
      openModal();
    }
    if (e.key === 'Escape') {
      closeModal();
    }
  });

  input?.addEventListener('input', async (e) => {
    const query = e.target.value;
    if (!query.trim()) {
      if (resultsContainer) resultsContainer.innerHTML = '';
      return;
    }

    const pf = await initPagefind();
    if (!pf) return;

    const search = await pf.search(query);
    if (!resultsContainer) return;

    if (search.results.length === 0) {
      resultsContainer.innerHTML = '<p class="no-results">未找到相关内容</p>';
      return;
    }

    resultsContainer.innerHTML = '';
    const results = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
    
    results.forEach(data => {
      const item = document.createElement('a');
      item.href = data.url;
      item.className = 'result-item';
      item.innerHTML = `
        <h3>${data.meta.title}</h3>
        <p>${data.excerpt}</p>
      `;
      resultsContainer.appendChild(item);
    });
  });

  // Handle Astro transitions
  document.addEventListener('astro:after-swap', () => {
    const newTrigger = document.getElementById('search-trigger');
    const newModal = document.getElementById('search-modal');
    const newBackdrop = newModal?.querySelector('.modal-backdrop');
    
    newTrigger?.addEventListener('click', openModal);
    newBackdrop?.addEventListener('click', closeModal);
  });
</script>

<style>
  .search-wrapper {
    display: flex;
    align-items: center;
    margin-right: 0.5rem;
  }

  #search-trigger {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
    border-radius: 4px;
  }

  #search-trigger:hover {
    color: var(--text-primary);
  }

  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
  }

  .modal.active {
    display: flex;
  }

  .modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--bg);
    opacity: 0.98;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .modal-content {
    position: relative;
    width: 90%;
    max-width: 600px;
    z-index: 1001;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: var(--bg);
    padding: 1rem;
    border-radius: 8px;
    /* Removed redundant flex-direction if any */
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  #search-input {
    width: 100%;
    background: none;
    border: none;
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
    font-size: 1.25rem;
    color: var(--text-primary);
    outline: none;
    font-family: var(--sans);
  }

  .search-hint {
    position: absolute;
    right: 0;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .results-container {
    max-height: 50vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    scrollbar-width: none;
  }

  .results-container::-webkit-scrollbar {
    display: none;
  }

  .result-item {
    text-decoration: none;
    color: var(--text-primary);
    padding: 1rem;
    border: 1px solid transparent;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .result-item:hover {
    background: var(--code-bg);
    border-color: var(--border);
  }

  .result-item h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
  }

  .result-item p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .no-results {
    text-align: center;
    color: var(--text-tertiary);
    margin-top: 2rem;
  }

  :global(body.search-open) {
    overflow: hidden;
  }
</style>
