---
---

<div class="search-wrapper">
  <button id="search-trigger" aria-label="Search" title="Search (Ctrl+K or /)">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
  </button>

  <div id="search-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
      <div class="search-input-wrapper">
        <input type="text" id="search-input" placeholder="搜索文章..." autocomplete="off" />
        <span class="search-hint">ESC 退出</span>
      </div>
      <div id="search-results" class="results-container"></div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    let pagefind;
    let searchId = 0;

    async function initPagefind() {
      if (pagefind) return pagefind;
      try {
        pagefind = await import('/pagefind/pagefind.js');
        await pagefind.options({
          "excerptLength": 20
        });
        return pagefind;
      } catch (e) {
        console.error('Failed to load pagefind:', e);
        return null;
      }
    }

    function setupSearch() {
      const trigger = document.getElementById('search-trigger');
      const modal = document.getElementById('search-modal');
      const backdrop = modal?.querySelector('.modal-backdrop');
      const input = document.getElementById('search-input');
      const resultsContainer = document.getElementById('search-results');

      if (!trigger || !modal || !input || !resultsContainer) return;

      function openModal() {
        modal.classList.add('active');
        document.body.classList.add('search-open');
        setTimeout(() => input.focus(), 50);
        initPagefind();
      }

      function closeModal() {
        modal.classList.remove('active');
        document.body.classList.remove('search-open');
        input.value = '';
        resultsContainer.innerHTML = '';
      }

      trigger.onclick = (e) => {
        e.preventDefault();
        openModal();
      };
      
      if (backdrop) {
        backdrop.onclick = (e) => {
          e.preventDefault();
          closeModal();
        };
      }

      input.oninput = async (e) => {
        const query = e.target.value.trim();
        const currentSearchId = ++searchId;
        
        if (!query) {
          resultsContainer.innerHTML = '';
          return;
        }

        const pf = await initPagefind();
        if (!pf || currentSearchId !== searchId) return;

        // MULTI-STRATEGY SEARCH:
        // Try searching with literal first, then fallback to fragmented if symbols are present
        let search = await pf.search(query);
        
        if (search.results.length === 0 && /[.\-\/]/.test(query)) {
          const processedQuery = query.replace(/[.\-\/]/g, ' ');
          const altSearch = await pf.search(processedQuery);
          if (altSearch.results.length > 0) {
            search = altSearch;
          }
        }
        
        if (currentSearchId !== searchId) return;

        if (search.results.length === 0) {
          resultsContainer.innerHTML = '<p class="no-results">未找到相关内容</p>';
          return;
        }

        const rawResults = await Promise.all(search.results.slice(0, 10).map(r => r.data()));
        if (currentSearchId !== searchId) return;

        const seen = new Set();
        const filteredResults = [];
        
        for (const data of rawResults) {
          let url = data.url.replace(/https?:\/\/[^\/]+/, '').split('?')[0].split('#')[0].replace(/\/index\.html$/, '').replace(/\/+$/, '');
          if (url === '') url = '/';
          
          if (!seen.has(url)) {
            seen.add(url);
            filteredResults.push({ ...data, url });
          }
          if (filteredResults.length >= 6) break;
        }

        resultsContainer.innerHTML = '';
        
        filteredResults.forEach(data => {
          const item = document.createElement('a');
          item.href = data.url;
          item.className = 'result-item';
          
          const highlightText = (text, q) => {
            if (!q || !text) return text;
            // Split by symbols to catch parts of n-gram or 1.25
            const parts = q.split(/[.\s\-\/]+/).filter(p => p.length > 0);
            if (parts.length === 0) {
               const regex = new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
               return text.replace(regex, '<mark>$1</mark>');
            }
            // Sort by length to match longest tokens first
            const pattern = [...new Set(parts)].sort((a,b) => b.length - a.length)
              .map(p => p.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
            const regex = new RegExp(`(${pattern})`, 'gi');
            return text.replace(regex, '<mark>$1</mark>');
          };

          const highlightedTitle = highlightText(data.meta.title || 'Untitled', query);

          const metaItems = [];
          if (data.meta.date) metaItems.push(`<span class="res-date">${highlightText(data.meta.date, query)}</span>`);
          if (data.meta.category) metaItems.push(`<span class="res-category">${highlightText(data.meta.category, query)}</span>`);
          if (data.meta.tags) {
            const cleanTags = data.meta.tags.split(',')
              .map(t => t.trim().replace(/^#+/, ''))
              .filter(t => t)
              .map(t => `#${t}`)
              .join(' ');
            metaItems.push(`<span class="res-tags">${highlightText(cleanTags, query)}</span>`);
          }
          const metaHtml = metaItems.length > 0 
            ? `<div class="result-meta">${metaItems.join(' <span class="res-sep">·</span> ')}</div>` 
            : '';

          item.innerHTML = `
            <h3>${highlightedTitle}</h3>
            ${metaHtml}
            <p>${data.excerpt}</p>
          `;
          resultsContainer.appendChild(item);
        });
      };

      const handleKeydown = (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          openModal();
        }
        if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
          e.preventDefault();
          openModal();
        }
        if (e.key === 'Escape') {
          closeModal();
        }
      };

      document.removeEventListener('keydown', window._handleSearchKeydown);
      window._handleSearchKeydown = handleKeydown;
      document.addEventListener('keydown', window._handleSearchKeydown);
    }

    document.addEventListener('astro:page-load', setupSearch);
  })();
</script>

<style>
  .search-wrapper {
    display: flex;
    align-items: center;
    margin-right: 0.5rem;
  }

  #search-trigger {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
    border-radius: 4px;
  }

  #search-trigger:hover {
    color: var(--text-primary);
  }

  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
  }

  .modal.active {
    display: flex;
  }

  .modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--bg);
    opacity: 0.98;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .modal-content {
    position: relative;
    width: 90%;
    max-width: 600px;
    z-index: 1001;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: var(--bg);
    padding: 1rem;
    border-radius: 8px;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  #search-input {
    width: 100%;
    background: none;
    border: none;
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
    font-size: 1.25rem;
    color: var(--text-primary);
    outline: none;
    font-family: var(--sans);
  }

  .search-hint {
    position: absolute;
    right: 0;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .results-container {
    max-height: 50vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    scrollbar-width: none;
  }

  .results-container::-webkit-scrollbar {
    display: none;
  }

  .result-item {
    text-decoration: none !important;
    color: var(--text-primary) !important;
    padding: 1rem;
    border: 1px solid transparent;
    border-radius: 4px;
    transition: all 0.2s ease;
    display: block;
  }

  .result-item:visited {
    color: var(--text-primary) !important;
  }

  .result-item:hover {
    background: var(--code-bg);
    border-color: var(--border);
  }

  .result-item h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
  }

  .result-meta {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-bottom: 0.5rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .res-sep {
    opacity: 0.5;
  }

  .res-category {
    color: var(--text-secondary);
  }

  .res-tags {
    font-style: italic;
  }

  .result-item p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .result-item :global(mark) {
    background-color: var(--mark) !important;
    color: var(--text-primary) !important;
    border-radius: 2px;
    padding: 0 2px;
  }

  .no-results {
    text-align: center;
    color: var(--text-tertiary);
    margin-top: 2rem;
  }

  :global(body.search-open) {
    overflow: hidden;
  }
</style>
